{
  "name": "@zeptly/registry-execution-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Git-native registry of Zeptly Execution Agent definitions",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "validate:examples": "node scripts/validate.mjs --root examples --allow-candidates",
    "check-changes": "node scripts/check-changes.mjs",
    "release": "node scripts/release.mjs",
    "build:index": "node scripts/build-index.mjs",
    "test": "node --test test/*.test.mjs",
    "ci": "npm run validate && npm run validate:examples && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.6.0"
  }
}
