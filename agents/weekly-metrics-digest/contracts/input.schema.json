{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["metrics", "channel_ref"],
  "properties": {
    "metrics": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string" } },
    "channel_ref": { "type": "string" },
    "week_ending": { "type": "string", "format": "date" }
  }
}
