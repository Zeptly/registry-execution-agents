{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zeptly.dev/registry/v1alpha1/lifecycle.schema.json",
  "title": "Lifecycle overlay — append-only lifecycle events for one identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "subject", "events"],
  "properties": {
    "apiVersion": { "const": "registry.zeptly.dev/v1alpha1" },
    "kind": { "const": "LifecycleOverlay" },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["registry", "id"],
      "properties": {
        "registry": { "const": "execution-agents" },
        "id": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/id" }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "digest", "state", "at", "actor"],
        "properties": {
          "version": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/semver" },
          "digest": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/digest" },
          "state": { "enum": ["active", "deprecated", "revoked"] },
          "at": { "type": "string", "format": "date-time" },
          "actor": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/principal" },
          "reason": { "type": "string", "minLength": 3 },
          "supersededBy": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/reference" }
        }
      }
    }
  }
}
