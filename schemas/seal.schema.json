{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zeptly.dev/registry/v1alpha1/seal.schema.json",
  "title": "Seal — content-addressed identity of a published artifact version",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "subject", "algorithm", "digest", "artifactDigest", "excludedFields", "files"],
  "properties": {
    "apiVersion": { "const": "registry.zeptly.dev/v1alpha1" },
    "kind": { "const": "Seal" },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["registry", "id", "version"],
      "properties": {
        "registry": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/registryLabel" },
        "id": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/id" },
        "version": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/semver" }
      }
    },
    "algorithm": { "const": "sha256" },
    "digest": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/digest" },
    "artifactDigest": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/digest" },
    "excludedFields": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "object",
      "propertyNames": { "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$" },
      "additionalProperties": { "$ref": "https://schemas.zeptly.dev/registry/v1alpha1/common.schema.json#/$defs/digest" }
    }
  }
}
