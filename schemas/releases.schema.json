{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.zeptly.dev/registry-execution-agents/1.0/releases.schema.json",
  "title": "Execution Agent release ledger",
  "description": "Append-only per-agent ledger. Each entry pins a released version to its content digest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent", "releases"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "agent": { "$ref": "https://schemas.zeptly.dev/registry-execution-agents/1.0/execution-agent.schema.json#/$defs/agentId" },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "digest", "released_at", "change_ref", "git_tag"],
        "properties": {
          "version": { "$ref": "https://schemas.zeptly.dev/registry-execution-agents/1.0/execution-agent.schema.json#/$defs/semver" },
          "digest": { "$ref": "https://schemas.zeptly.dev/registry-execution-agents/1.0/execution-agent.schema.json#/$defs/digest" },
          "released_at": { "type": "string", "format": "date" },
          "change_ref": { "type": "string", "pattern": "^(bootstrap|github:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+#[0-9]+)$" },
          "git_tag": { "type": "string", "pattern": "^exec\\.[a-z0-9-]+@[0-9]+\\.[0-9]+\\.[0-9]+.*$" },
          "approved_by": { "type": "array", "items": { "$ref": "https://schemas.zeptly.dev/registry-execution-agents/1.0/execution-agent.schema.json#/$defs/principal" } },
          "evaluation_evidence": {
            "type": "array",
            "items": { "$ref": "https://schemas.zeptly.dev/registry-execution-agents/1.0/execution-agent.schema.json#/$defs/evidenceRef" }
          }
        }
      }
    }
  }
}
